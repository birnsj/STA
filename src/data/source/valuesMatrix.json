{
  "source": {
    "book": "Star Trek Adventures 2E Core Rulebook",
    "section": "Sample Values",
    "page": 96,
    "note": "Book: a list of sample values; players may use them, adapt them, or write their own (p.92). Listed in the order the book's text gives them. File name kept from the earlier Captain's Log Values Matrix so readers don't change."
  },
  "values": [
    { "id": "core-value-01", "text": "A good mystery is irresistible" },
    { "id": "core-value-02", "text": "To boldly go where no one has gone before" },
    { "id": "core-value-03", "text": "Act with confidence, even if you don’t feel confident" },
    { "id": "core-value-04", "text": "Seeking to find myself far from home" },
    { "id": "core-value-05", "text": "All’s fair in love and politics" },
    { "id": "core-value-06", "text": "Admirals don’t intimidate me" },
    { "id": "core-value-07", "text": "Always up for an adventure" },
    { "id": "core-value-08", "text": "Experience will earn me that promotion" },
    { "id": "core-value-09", "text": "Build relationships" },
    { "id": "core-value-10", "text": "Humility is the best path to honesty" },
    { "id": "core-value-11", "text": "Good leaders get their hands dirty" },
    { "id": "core-value-12", "text": "\"Weird\" is part of the job" },
    { "id": "core-value-13", "text": "I finish what I start" },
    { "id": "core-value-14", "text": "I can make something from nothing" },
    { "id": "core-value-15", "text": "Information is power" },
    { "id": "core-value-16", "text": "Sensors can’t tell you everything" },
    { "id": "core-value-17", "text": "Listen to opposing viewpoints" },
    { "id": "core-value-18", "text": "Exploration is the blood that fills my veins" },
    { "id": "core-value-19", "text": "Loyalty matters most" },
    { "id": "core-value-20", "text": "Push me too far and you’ll see my ugly side" },
    { "id": "core-value-21", "text": "Patience is a virtue" },
    { "id": "core-value-22", "text": "Adaptation is survival" },
    { "id": "core-value-23", "text": "Resistance is never futile" },
    { "id": "core-value-24", "text": "Never leave a stone unturned" },
    { "id": "core-value-25", "text": "Sometimes you have to take a leap of faith" },
    { "id": "core-value-26", "text": "The Academy taught me 10 percent of what I know" },
    { "id": "core-value-27", "text": "Spoiling for a fight" },
    { "id": "core-value-28", "text": "We are all connected despite being worlds apart" },
    { "id": "core-value-29", "text": "Spring into action" },
    { "id": "core-value-30", "text": "Keep a smile on your face no matter how you feel" },
    { "id": "core-value-31", "text": "Teamwork makes for success" },
    { "id": "core-value-32", "text": "Crew comes first" },
    { "id": "core-value-33", "text": "The mission comes first" },
    { "id": "core-value-34", "text": "Diplomacy is the first and last solution to anything" },
    { "id": "core-value-35", "text": "Willing to sacrifice myself to save my crew" },
    { "id": "core-value-36", "text": "Our best defense is knowledge" },
    { "id": "core-value-37", "text": "Get them before they get you" },
    { "id": "core-value-38", "text": "First contact? Sign me up!" },
    { "id": "core-value-39", "text": "We are stronger united than apart" },
    { "id": "core-value-40", "text": "Space really wants us dead" },
    { "id": "core-value-41", "text": "My knowledge is giving you a fighting chance" },
    { "id": "core-value-42", "text": "I will not fight for Starfleet, but I will defend its ideals" },
    { "id": "core-value-43", "text": "Within the shadows, you are free to move" },
    { "id": "core-value-44", "text": "I fix what is broken" },
    { "id": "core-value-45", "text": "The daily grind is worth it" },
    { "id": "core-value-46", "text": "I do not like hijinks" },
    { "id": "core-value-47", "text": "Universal law is for lackeys" },
    { "id": "core-value-48", "text": "Do better, be better" },
    { "id": "core-value-49", "text": "The crew is my family" },
    { "id": "core-value-50", "text": "I'm a good bad influence" },
    { "id": "core-value-51", "text": "I care too much about what people think of me" },
    { "id": "core-value-52", "text": "Everyone deserves a second chance" },
    { "id": "core-value-53", "text": "Friends are the family you choose" },
    { "id": "core-value-54", "text": "Some things don't deserve forgiveness" },
    { "id": "core-value-55", "text": "We are nothing without order and justice" },
    { "id": "core-value-56", "text": "Sometimes hope is a choice" },
    { "id": "core-value-57", "text": "My lies are the truest of all stories" },
    { "id": "core-value-58", "text": "We didn't come out here to play God" },
    { "id": "core-value-59", "text": "Well-placed words are deadlier than a phaser" },
    { "id": "core-value-60", "text": "I study war to learn from the best" },
    { "id": "core-value-61", "text": "You can’t let them know what you value" },
    { "id": "core-value-62", "text": "I am surrounded by a team I trust" },
    { "id": "core-value-63", "text": "With proper discipline, anything is possible" },
    { "id": "core-value-64", "text": "The only way to defeat fear is to tell it \"No\"" },
    { "id": "core-value-65", "text": "Technology is simpler than people" },
    { "id": "core-value-66", "text": "Starfleet to the core" },
    { "id": "core-value-67", "text": "Always find ways to be useful" },
    { "id": "core-value-68", "text": "Layer yourself in subtleties" },
    { "id": "core-value-69", "text": "People are more than flesh and blood" },
    { "id": "core-value-70", "text": "Every puzzle has a solution" },
    { "id": "core-value-71", "text": "Never hide who you are" },
    { "id": "core-value-72", "text": "I am my own keeper" }
  ]
}
