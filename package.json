{
  "name": "st-adventures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --import ./tools/jsonLoader.mjs --test \"tests/**/*.test.js\"",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.stadventures.charactercreator",
    "productName": "ST Adventures",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/characterStore.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "portable": {
      "artifactName": "ST-Adventures-${version}-portable.exe"
    }
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.89.0",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.9.2": true
  }
}
