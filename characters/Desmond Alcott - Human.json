    "talents": [
      {
        "id": "bolster",
        "name": "Bolster",
        "category": "command",
        "choice": null,
        "description": "When you succeed at any task using your Command during an action scene, you may spend Momentum to recover Stress suffered by your allies. When you spend 1 Momentum (Repeatable), one ally who can see and hear you recovers 1 Stress. You may affect multiple allies, but each ally affected may only recover 1 Stress in this way each time this talent is used.",
        "requirements": [
          {
            "type": "department",
            "id": "command",
            "min": 3
          }
        ],
        "effects": [
          {
            "type": "special",
            "action": "allyRecoversStress",
            "amount": 1,
            "cost": {
              "momentum": 1
            },
            "when": "you succeed at a Command task in an action scene"
          }
        ],
        "era": null,
        "source": {
