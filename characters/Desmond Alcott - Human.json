      },
      {
        "id": "coveringAdvance",
        "name": "Covering Advance",
        "category": "conn",
        "choice": null,
        "description": "When you succeed at a task to maneuver your ship, you may spend 2 Momentum to provide cover for allied ships. When an enemy vessel next makes an Attack, before the beginning of your next turn, if you are the closest ship to that attacker but they do not target you, the difficulty of their Attack is equal to your ship’s Scale.",
        "requirements": [
          {
            "type": "department",
            "id": "conn",
            "min": 3
          }
        ],
        "effects": [
          {
            "type": "difficulty",
            "target": "enemy",
            "setTo": "shipScale",
            "cost": {
              "momentum": 2
            },
            "when": "enemy attacks an ally ship while you are closest"
          }
        ],
        "era": null,
        "source": {
