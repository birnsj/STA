    {
      "id": "intro",
      "type": "npc",
      "position": [560, 340],
      "speaker": "",
      "text": "Starfleet. You walk where the Empire holds the ground. State your purpose, or draw your blade.",
      "next": "mainChoice"
    },
    {
      "id": "returnLine",
      "type": "npc",
      "position": [560, 180],
      "speaker": "",
