      "type": "choice",
      "position": [820, 260],
      "options": [
        {
          "id": "persuade",
          "text": "We came in peace, and we can leave in peace. Hear us out.",
          "conditions": [
            { "npc": "disposition", "op": "notEquals", "value": "friendly" },
            { "flag": "{npc}.persuaded", "op": "isFalse" }
          ],
          "next": "markPersuaded"
        },
        {
          "id": "intimidate",
          "text": "Stand aside. You do not want to learn what we can do.",
          "conditions": [
            { "npc": "intimidated", "op": "isFalse" },
            { "flag": "{npc}.threatened", "op": "isFalse" }
          ],
          "next": "markThreatened"
        },
        { "id": "fight", "text": "Then we settle this the Klingon way.", "conditions": [], "next": "startFight" },
        { "id": "leave", "text": "We will go.", "conditions": [], "next": "end" }
      ]
    },
    {
      "id": "markPersuaded",
      "type": "action",
      "position": [1080, 20],
      "actions": [{ "type": "changeFlag", "flag": "{npc}.persuaded", "op": "set", "value": true }],
      "next": "persuadeCheck"
    },
    {
      "id": "persuadeCheck",
      "type": "check",
      "position": [1340, 20],
      "label": "Persuade the Klingon",
      "attribute": "presence",
      "department": "command",
      "difficulty": 2,
      "focuses": ["Persuasion", "Diplomacy", "Negotiation", "Composure"],
      "complicationRange": 1,
      "onComplication": [],
      "opposed": true,
