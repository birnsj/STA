      "type": "npc",
      "position": [1860, 300],
      "speaker": "",
      "text": "Tcha! Enough. I will not stand against you today. Do not mistake that for fear.",
      "next": "mainChoice"
    },
    {
      "id": "intimidateLoss",
      "type": "action",
      "position": [1600, 460],
      "actions": [{ "type": "adjustCheckDifficulty", "amount": 1 }],
