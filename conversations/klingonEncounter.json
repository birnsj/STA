      "difficulty": 2,
      "focuses": ["Intimidation", "Interrogation", "Hand Phasers", "Tactics"],
      "complicationRange": 1,
      "onComplication": [],
      "opposed": true,
      "success": "intimidateWin",
      "failure": "intimidateLoss"
    },
    {
