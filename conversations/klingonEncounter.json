      "type": "npc",
      "position": [1860, -40],
      "speaker": "",
      "text": "Hmph. You speak with more honour than I expected from a Starfleet. I will not strike first.",
      "next": "mainChoice"
    },
    {
      "id": "persuadeLoss",
      "type": "npc",
      "position": [1600, 100],
      "speaker": "",
      "text": "Words are wind. Do not waste mine.",
      "next": "mainChoice"
    },
    {
      "id": "markThreatened",
